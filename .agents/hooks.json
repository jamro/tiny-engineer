{
  "tiny-engineer": {
    "PreInvocation": [
      {
        "command": "node packages/tiny-engineer-cli/bin/tiny-engineer.js hook antigravity PreInvocation",
        "timeout": 3
      }
    ],
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "command": "node packages/tiny-engineer-cli/bin/tiny-engineer.js hook antigravity PreToolUse",
            "timeout": 3
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "command": "node packages/tiny-engineer-cli/bin/tiny-engineer.js hook antigravity PostToolUse",
            "timeout": 3
          }
        ]
      }
    ],
    "Stop": [
      {
        "command": "node packages/tiny-engineer-cli/bin/tiny-engineer.js hook antigravity Stop",
        "timeout": 3
      }
    ]
  }
}
